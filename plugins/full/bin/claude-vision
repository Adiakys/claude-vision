#!/usr/bin/env bash
#
# Dev wrapper: used when running this repo directly (not as an installed
# plugin). Mirrors the logic of the wrapper generated by hooks/bootstrap.sh:
# prepends $HOME/.local/state/claude-vision/lib to PYTHONPATH if it exists,
# otherwise falls back to the caller's existing Python environment.

set -eu

STATE="${HOME}/.local/state/claude-vision"
if [ -d "${STATE}/lib" ]; then
    export PYTHONPATH="${STATE}/lib${PYTHONPATH:+:${PYTHONPATH}}"
fi

exec python3 -m claude_vision "$@"
